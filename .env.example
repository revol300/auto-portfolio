# 한국투자증권 Open API (공통)
KIS_APP_KEY=
KIS_APP_SECRET=

# 실전/모의 투자 (prod | virtual)
KIS_ENV=virtual

# 한국주식 계좌 (--market ko)
KIS_KO_ACCOUNT_NO=
KIS_KO_ACCOUNT_PRODUCT_CODE=01

# 미국주식 계좌 (--market us)
KIS_US_ACCOUNT_NO=
KIS_US_ACCOUNT_PRODUCT_CODE=01

# DART OpenAPI — 한국주식 전략 사용 시 필요 (https://opendart.fss.or.kr)
DART_API_KEY=
